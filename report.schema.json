            "type": "string",
            "maxLength": 512
          },
          "maxItems": 65536
        },
        "clientExtensions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 65536
        },
        "extensionCount": {
          "type": "integer",
          "minimum": 0
        },
        "clientExtensionCount": {
          "type": "integer",
          "minimum": 0
        }
