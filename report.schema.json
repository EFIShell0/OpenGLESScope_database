        "modeId": {
          "type": [
            "integer",
            "number",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "number",
            "null"
          ]
        },
        "height": {
          "type": [
            "integer",
            "number",
            "null"
          ]
