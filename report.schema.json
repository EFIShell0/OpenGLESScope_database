            "type": "string",
            "maxLength": 512
          },
          "maxItems": 65536
        },
        "extensionCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "egl": {
      "type": "object",
      "required": [
        "vendor",
        "version",
        "initializedVersion",
        "clientApis",
        "extensions",
        "clientExtensions",
