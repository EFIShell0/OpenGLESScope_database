{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenGLESScope Database Submission",
  "type": "object",
  "required": [
    "schemaVersion",
    "application",
    "device",
    "gpu",
    "driver",
    "opengles",
    "egl",
    "display",
    "collection",
    "technicalReport",
    "reportText"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "application": {
      "type": "object",
      "required": [
        "name",
        "packageName",
        "version",
        "versionCode",
        "applicationAbi",
        "supportedDeviceAbis"
      ],
      "properties": {
        "name": {
          "const": "OpenGLESScope"
        },
        "packageName": {
          "const": "com.efishell.openglesscope"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0\\.(?:1\\.(?:1[7-9]|[2-9][0-9]|[1-9][0-9]{2,})|(?:[2-9]|[1-9][0-9]+)\\.[0-9]+)|1\\.(?:2\\.1|3\\.0|4\\.[01]|5\\.[01]|6\\.0|7\\.0|8\\.0|9\\.[0-3]))$",
          "maxLength": 32
        },
        "versionCode": {
          "type": "integer",
          "minimum": 117
        },
        "applicationAbi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "supportedDeviceAbis": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "required": [
        "manufacturer",
        "model",
        "product",
        "androidRelease",
        "sdk"
      ],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product": {
          "type": "string",
          "maxLength": 256
        },
        "androidRelease": {
          "type": "string",
          "maxLength": 64
        },
        "sdk": {
          "type": "integer",
          "minimum": 1
        },
        "securityPatch": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 32
        },
        "brand": {
          "type": "string",
          "maxLength": 256
        },
        "device": {
          "type": "string",
          "maxLength": 256
        },
        "board": {
          "type": "string",
          "maxLength": 256
        },
        "hardware": {
          "type": "string",
          "maxLength": 256
        },
        "codename": {
          "type": "string",
          "maxLength": 256
        },
        "buildId": {
          "type": "string",
          "maxLength": 256
        },
        "incremental": {
          "type": "string",
          "maxLength": 256
        },
        "fingerprint": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "gpu": {
      "type": "object",
      "required": [
        "name",
        "vendor"
