{
  "name": "openglesscope-database-api",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:create": "wrangler auth create openglesscope",
    "auth:activate": "wrangler auth activate openglesscope .",
    "auth:list": "wrangler auth list",
    "auth:status": "wrangler whoami",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply openglesscope-database --remote",
    "migrations:list": "wrangler d1 migrations list openglesscope-database --remote",
    "d1:count": "wrangler d1 execute openglesscope-database --remote --command \"SELECT COUNT(*) AS report_count FROM reports;\"",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "4.124.0"
  }
}
